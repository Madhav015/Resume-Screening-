# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key - server-only, NEVER expose to the browser. Used for the
# resume-scoring background route which needs to bypass RLS to write scores.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# Set to "true" to test the whole app (upload, extraction, dashboard,
# multi-tenancy) with $0 cost and no Anthropic API key required — scoring
# falls back to a keyword heuristic instead of calling Claude. See the
# comment above MOCK_SCORING in src/lib/claude/scoring.ts. Leave unset (or
# "false") to use real Claude scoring.
MOCK_SCORING=false

# Used to build absolute callback URLs for email confirmation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay (Settings > API Keys in the Razorpay Dashboard; use the "Test
# Mode" keys until you've completed KYC and want to take real payments).
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# A secret YOU choose when you configure the webhook (Settings > Webhooks) —
# not the same value as RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET=...

# 3-tier pricing (Starter / Growth / Pro — see src/lib/billing/tiers.ts).
# Each is its own Plan in Products > Subscriptions > Plans; copy each
# plan's plan_id here. A tier with no plan_id set just shows as "Not
# configured" on the Billing page instead of breaking anything.
RAZORPAY_PLAN_ID_STARTER=plan_...
RAZORPAY_PLAN_ID_GROWTH=plan_...
RAZORPAY_PLAN_ID_PRO=plan_...
